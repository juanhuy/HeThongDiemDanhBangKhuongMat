      a.href = url;
      a.download = `bao_cao_tong_ket_${reportClass}.xlsx`;
      document.body.appendChild(a);
      a.click();
      a.remove();
      window.URL.revokeObjectURL(url);
      showToast("Đã xuất file báo cáo thành công!");
    } catch (err) {
