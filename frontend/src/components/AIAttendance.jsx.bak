  if (user && role === 'sinh_vien' && (!user.mssv || user.mssv === 'N/A')) {
    user.mssv = user.username.toUpperCase();
  }

  const activeTab = activeMenu;

  // --- Admin Tab States ---
  const [pendingFaces, setPendingFaces] = useState([]);
  const [regMssv, setRegMssv] = useState('');
